# Data and model artifacts.
# Anchored to the repository root on purpose: an unanchored "data/" also matched
# src/niftypulse/data/, which silently kept the entire data layer out of git.
/data/
/artifacts/
/logs/

# Credentials — never commit these
.env
*.token
upstox_token.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated protobuf stubs are committed deliberately so the package installs
# without a protoc toolchain. To regenerate:
#   uv run python -m grpc_tools.protoc -I src/niftypulse/data/proto \
#     --python_out=src/niftypulse/data/proto \
#     src/niftypulse/data/proto/MarketDataFeed.proto

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

.commandcode/