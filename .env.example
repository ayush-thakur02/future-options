# Upstox API credentials.
#
# Create an app at https://account.upstox.com/developer/apps
# The redirect URI must match exactly what is registered on the app.
#
# Then log in once per trading day with the login flow in
# plugins.sources.upstox.auth — Upstox access tokens expire at 03:30 IST the
# following morning.

UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Optional. If set, this takes precedence over the token saved by that login.
# Useful for CI or a scheduled job that injects a fresh token itself.
UPSTOX_ACCESS_TOKEN=

# Optional. Overrides the project root used for data/, artifacts/ and logs/.
# NIFTYPULSE_HOME=
